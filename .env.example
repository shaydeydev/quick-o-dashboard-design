# Nebius Token Factory API key (required)
NEBIUS_API_KEY=

# Tavily search API key (required)
TAVILY_API_KEY=

# Vision-language model id on Nebius
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL

# Optional: override the OpenAI-compatible Nebius base URL used by the vision routes
# NEBIUS_BASE_URL=

# PayPal sandbox client id (falls back to "test" if empty)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=